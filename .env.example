# Domain kanonis (dipakai sitemap.xml, robots.txt, dan metadataBase).
# Di produksi isi dengan domain asli, mis. https://masjoki.id
NEXT_PUBLIC_SITE_URL=https://masjoki.vercel.app

# Nomor WhatsApp admin, format internasional tanpa tanda plus.
NEXT_PUBLIC_WHATSAPP=6289619774116

# Kontak yang tampil di footer.
NEXT_PUBLIC_EMAIL=halo@masjoki.id
NEXT_PUBLIC_INSTAGRAM=masjoki.id

# KHUSUS SERVER (jangan pakai awalan NEXT_PUBLIC_).
# Kunci penandatanganan voucher AI Humanizer. Ganti dengan string acak panjang.
# Tanpa nilai ini, voucher bertanda tangan (MJ-xxxx) akan ditolak.
HUMANIZER_VOUCHER_SECRET=ganti-dengan-string-acak-panjang

# Google Gemini AI API (Humanizer Deep Rewrite Engine)
# Dapatkan API Key gratis di https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
# Opsional: beberapa key dipisah koma, titik koma, atau baris baru.
# Jika diisi, sistem memakai pool ini secara bergiliran lalu mencoba key berikutnya
# saat key sebelumnya invalid atau terkena quota/rate limit.
# GEMINI_API_KEYS=key-1,key-2,key-3

# Supabase (Kunci Token AI Humanizer dan Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
